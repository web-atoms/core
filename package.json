{
  "name": "@web-atoms/core",
  "version": "2.6.30",
  "description": "Web Atoms Core",
  "main": "index.js",
  "esm": {
    "dist": "dist-esm"
  },
  "scripts": {
    "test1": "node ./node_modules/@web-atoms/unit-test/index.js ./dist/tests",
    "test": "istanbul cover ./node_modules/@web-atoms/unit-test/index.js ./dist/tests",
    "build-css": "npx postcss \"./src/**/*.css\" --base ./src --dir ./dist --map --verbose",
    "build-css-esm": "npx postcss \"./src/**/*.css\" --base ./src --dir ./dist-esm --map --verbose",
    "build-css-watch": "npx postcss \"./src/**/*.css\" --base src --dir dist --map -w",
    "build-css-jex": "npx jex ./build.jsx",
    "build-css-watch-jex": "npx jex ./build.jsx --watch",
    "posttest": "remap-istanbul -i ./coverage/coverage.json -t html -o ./html-report",
    "postversion": "git push --follow-tags",
    "push": "git add -A && git commit -m \"dep vb\" && npm version patch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web-atoms/core"
  },
  "keywords": [
    "web",
    "atoms",
    "core"
  ],
  "author": "Akash Kava",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neurospeech/web-atoms-core/issues"
  },
  "homepage": "https://github.com/neurospeech/web-atoms-core#readme",
  "devDependencies": {
    "@neurospeech/jex": "^1.0.117",
    "@web-atoms/pack": "1.0.111",
    "@web-atoms/module-loader": "^2.1.89",
    "@web-atoms/unit-test": "^2.0.5",
    "@web-atoms/postcss-styled-js": "^1.0.10",
    "@package-verse/esmpack": "^1.0.34",
    "colors": "^1.4.0",
    "istanbul": "^0.4.5",
    "jsdom": "^23.2.0",
    "path": "^0.12.7",
    "remap-istanbul": "^0.11.1",
    "test-dom": "^1.0.0",
    "tslib": "^2.8.1",
    "xmlhttprequest": "^1.8.0",
    "cssnano": "^7.0.6",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@web-atoms/date-time": "^3.0.18",
    "reflect-metadata": "^0.2.2"
  }
}
